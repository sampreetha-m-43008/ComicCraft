# Copy this file to ".env" and fill in your own values. NEVER commit the real .env file.

# Google Gemini key (free key from https://aistudio.google.com/apikey). Leave empty for DEMO mode.
GEMINI_API_KEY=your_key_here

# Hugging Face access token (https://huggingface.co/settings/tokens) for IMAGE_BACKEND=hf_api
IMAGE_API_KEY=your_key_here

# auto = use real AI when keys exist, otherwise DEMO | demo = force placeholders | live = require keys
COMICCRAFT_MODE=auto

# auto | mock | local | hf_api   (auto = hf_api if IMAGE_API_KEY is set, else mock)
IMAGE_BACKEND=auto
IMAGE_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5

# Change these if Google retires a model name
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_TIMEOUT_SECONDS=90
